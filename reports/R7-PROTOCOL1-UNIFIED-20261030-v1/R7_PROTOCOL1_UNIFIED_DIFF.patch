+   if(current==2)need(got.input_pair[0]==denseA[0] && got.input_pair[1]==denseA[1] && got.kernel_pair[0]==denseB[0] && got.kernel_pair[1]==denseB[1],"global terminal pairs lost crossroot contributions");
