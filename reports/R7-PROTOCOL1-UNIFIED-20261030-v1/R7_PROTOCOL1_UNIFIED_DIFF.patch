+   for(unsigned t=0;t<3;++t)for(std::size_t j=0;j<current/2;++j){auto x=denseA[2*j]*(Fr(1)-Fr(t))+denseA[2*j+1]*Fr(t);auto y=denseB[2*j]*(Fr(1)-Fr(t))+denseB[2*j+1]*Fr(t);evaluation[t]+=x*y;}
