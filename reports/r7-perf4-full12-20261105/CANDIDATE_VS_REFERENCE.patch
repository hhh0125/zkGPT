+  need(used<=meta && first<=cap-used,"PERF4 U metadata capacity budget");
+  for(std::size_t k=0;k<s.size();++k){auto original=input(k);shape(original,s[k].padded);roots[k].original=original;}
+  enabled=true;m.capacity_peak_bytes=used;
+ }
