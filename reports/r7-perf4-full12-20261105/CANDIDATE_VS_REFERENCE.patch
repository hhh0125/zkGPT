+ p_->check(id,&prefix);need(p_->consuming && k<p_->roots.size(),"PERF4 U read phase/root");auto&r=p_->roots[k];need(!r.seen && same(original,r.original),"PERF4 U repeated read/storage drift");r.seen=true;
