+struct FoldedU::Impl {
+ struct Root {InputSpan original;std::vector<Fr>values;bool seen=false;};
+ std::size_t n;unsigned bits=0;std::uint64_t cap,used=0;bool enabled=false,failed=false,consuming=false,ready=false;
+ std::string session;std::vector<Segment>segments;std::vector<Root>roots;std::vector<Fr>point;UFoldMetrics m;
