[
  {
    "id": "sanitize-configure",
    "argv": [
      "cmake",
      "-S",
      ".",
      "-B",
      "build/r5b-sanitize",
      "-DCMAKE_BUILD_TYPE=Debug",
      "-DCNPY_INCLUDE_DIR=/home/yttan/project/zkGPT/zkGPT-main/zkGPT-work/deps/cnpy/include",
      "-DCNPY_LIBRARY=/home/yttan/project/zkGPT/zkGPT-main/zkGPT-work/deps/cnpy/lib/libcnpy.a",
      "-DCMAKE_CXX_FLAGS=-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -O1",
      "-DCMAKE_EXE_LINKER_FLAGS=-fsanitize=address,undefined",
      "-DCMAKE_SHARED_LINKER_FLAGS=-fsanitize=address,undefined"
    ]
  },
  {
    "id": "sanitize-build",
    "argv": [
      "cmake",
      "--build",
      "build/r5b-sanitize",
      "--target",
      "r5b_tests",
      "r5b_trust_tests",
      "r5b_model_prove",
      "r5a_host_tests",
      "-j6"
    ]
  },
  {
    "id": "sanitize-targeted-tests",
    "argv": [
      "ctest",
      "--test-dir",
      "build/r5b-sanitize",
      "--output-on-failure",
      "-R",
      "r5b_|r5a_host_",
      "-j1"
    ],
    "env": {
      "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
      "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
    },
    "require_log": "100% tests passed"
  },
  {
    "id": "sanitize-real-witness",
    "argv": [
      "build/r5b-sanitize/src/paper_r2/r5b_model_prove",
      "reports/R5B/witness-sanitize-v1",
      "--witness-only"
    ],
    "env": {
      "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
      "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
    },
    "require_log": "WITNESS VALIDATED"
  }
